# ModelOps AI configuration — copy to .env and fill in. Never commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
#   (or: cd backend && python -m app.cli generate-secrets)

# --- General ---------------------------------------------------------------
ENVIRONMENT=development            # development | production | test
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173 # public URL of the web app
BACKEND_URL=http://localhost:8000  # public URL of the API (used in gateway examples)
# Comma-separated list of extra allowed browser origins. Leave empty when the frontend is
# served by the backend (same origin, the default production setup).
CORS_ORIGINS=

# --- Database (PostgreSQL) ----------------------------------------------------
# docker compose up -d db  starts a local server on port 5434
DATABASE_URL=postgresql+psycopg://modelops:modelops@127.0.0.1:5434/modelops

# --- Security (REQUIRED, at least 32 characters each) ---------------------------
JWT_SECRET_KEY=replace-with-a-long-random-value
# Encrypts provider API keys at rest. Losing it makes stored keys unreadable.
# For rotation use "new-secret,old-secret" then run: python -m app.cli rotate-keys
MASTER_ENCRYPTION_KEY=replace-with-a-different-long-random-value
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
MAX_REQUEST_BYTES=2000000

# --- Rate limits (requests per minute, per process) -------------------------------
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=300
RATE_LIMIT_GATEWAY_PER_MINUTE=120

# --- Provider endpoints (defaults shown; override only for proxies) -----------------
# OPENAI_BASE_URL=https://api.openai.com
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
PROVIDER_TIMEOUT_SECONDS=120

# --- AI Analyst (optional; platform-level key, separate from users' keys) -------------
AI_ANALYST_PROVIDER=               # openai | anthropic
AI_ANALYST_MODEL=                  # e.g. gpt-4.1-mini or a current Claude model ID
AI_ANALYST_API_KEY=
